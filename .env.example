# Room booking admin portal (src/app/admin/bookings)
# Office membership. Format: slo:a@x.in,b@x.in;oa:c@x.in;cfe:d@x.in;acad:e@x.in
# Server only. Malformed input is treated as empty.
BOOKING_OFFICES=
# Set to true to enable the persona switcher, reset and simulated submission. Server only.
BOOKING_DEMO_MODE=

# Public sandbox (throwaway demo only): no sign-in, fake data, one private copy per visitor.
# Ignored in production when STRAPI_API_TOKEN is set.
PUBLIC_SANDBOX=
SANDBOX_MAX_VISITORS=
SANDBOX_TTL_MINUTES=

# Student portal scheduler (long random string). Without it the tick route refuses every call.
CRON_SECRET=

# Student portal email. Dry-run unless BOTH are set. Set the second only after SPF, DKIM and DMARC are published.
EMAIL_MODE=
EMAIL_DOMAIN_VERIFIED=
# Domain used in Message-ID headers. Must be the verified sending domain when live.
EMAIL_MESSAGE_ID_DOMAIN=
# Long random string that signs the approve links in emails. Without it the links are switched off.
APPROVAL_TOKEN_SECRET=

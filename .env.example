# Room booking admin portal (src/app/admin/bookings)
# Office membership. Format: slo:a@x.in,b@x.in;oa:c@x.in;cfe:d@x.in;acad:e@x.in
# Server only. Malformed input is treated as empty.
BOOKING_OFFICES=
# Set to true to enable the persona switcher, reset and simulated submission. Server only.
BOOKING_DEMO_MODE=

# Public sandbox (throwaway demo only): no sign-in, fake data, one private copy per visitor.
# Ignored in production when STRAPI_API_TOKEN is set.
PUBLIC_SANDBOX=
SANDBOX_MAX_VISITORS=
SANDBOX_TTL_MINUTES=
